{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "models/all-MiniLM-L6-v2/model.onnx",
          "models/all-MiniLM-L6-v2/tokenizer.json",
          "knowledge_base/**/*.md"
        ]
      }
    }
  ]
}
