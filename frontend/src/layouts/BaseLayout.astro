---
interface Props {
  title: string;
  description: string;
}

import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/chat.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,480;9..144,560;9..144,640&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#ask-main">Skip to the assistant</a>
    <main id="ask-main" class="wrap ask-page">
      <slot />
    </main>
  </body>
</html>