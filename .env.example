# Copy to .env and adjust. All values are optional; defaults are local-first.
AHMED_RAG_KB_DIR=knowledge_base
AHMED_RAG_INDEX_DIR=storage/index
AHMED_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AHMED_RAG_OLLAMA_BASE_URL=http://localhost:11434
AHMED_RAG_OLLAMA_MODEL=qwen2.5-coder:7b
AHMED_RAG_OLLAMA_TIMEOUT_SECONDS=120
AHMED_RAG_SIMILARITY_THRESHOLD=0.35
AHMED_RAG_RETRIEVAL_TOP_K=5
AHMED_RAG_CHUNK_MAX_CHARS=1200
AHMED_RAG_CHUNK_OVERLAP_CHARS=200
# Comma-separated globs, matched against knowledge-base-relative paths.
# A bare name matches any single path component at any depth, 'dir/**' matches
# everything under that directory. A JSON array is also accepted.
# The value below is the default; set it to an empty value to index everything,
# including dot files, drafts and exports.
AHMED_RAG_KB_EXCLUDE_GLOBS=.*,drafts/**,_drafts/**,exports/**,*.tmp.md,*~
AHMED_RAG_MAX_MESSAGE_CHARS=2000
AHMED_RAG_LOG_LEVEL=INFO
